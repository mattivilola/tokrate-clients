{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokrate",
  "version": "0.1.13",
  "identifier": "dev.tokrate.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:51719",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tokrate",
        "width": 380,
        "height": 640,
        "minWidth": 340,
        "minHeight": 480,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Observed Codex performance in your tray",
    "category": "DeveloperTool",
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDNDBCRURFMkY3REVDNTkKUldSWjdIMHYzcjVBWElRblJnTW5BUDF1bjBHSEM3amVFVzhHRlVUMXpVMGhwTTdPRE0xUXkraXMK",
      "endpoints": ["https://tokrate.dev/updates/desktop/alpha.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
